{
  "name": "colonder",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop app built with Electron, Vite, and React",
  "email": "joeydavidbishop@gmail.com",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icons": "png2icons build/colonder-app-icon.png build/colonder-app-icon -allwe -bc",
    "dist": "npm run build && npm run icons && electron-builder --publish never",
    "dist:dir": "npm run build && npm run icons && electron-builder --dir",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed"
  },
  "dependencies": {
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "better-sqlite3": "^12.4.1",
    "bootstrap-icons": "^1.13.2",
    "formik": "^2.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "jsdom": "^26.1.0",
    "png2icons": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.neobaneling.colonder",
    "productName": "Colonder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/colonder-app-icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/colonder-app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/colonder-app-icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
